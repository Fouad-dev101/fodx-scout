# --- API server ---
PORT=4000
NODE_ENV=development
DATABASE_PATH=./data/fodx.db
LOG_LEVEL=info
# Comma-separated list of origins allowed to call the API (local dev default)
CORS_ORIGINS=http://localhost:5173

# --- AI provider (OPTIONAL — app runs without this) ---
# "openai" | "ollama" | "" (disabled)
AI_PROVIDER=
# OpenAI-compatible endpoint (also works for OpenRouter, Groq, etc.)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Ollama (local): AI_PROVIDER=ollama, AI_BASE_URL=http://127.0.0.1:11434

# --- Discovery (Overpass) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=60000
OVERPASS_MAX_RESULTS=200

# --- Website inspection safety limits ---
WEB_FETCH_TIMEOUT_MS=10000
WEB_FETCH_MAX_BYTES=524288
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_CONCURRENCY=3

# --- Agent budgets ---
AGENT_MAX_TOOL_CALLS=25
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_BUSINESSES_PER_INVESTIGATION=15